# ==========================================
# Gram Udyam Advisor — Environment Configuration
# ==========================================

# AI Advisory Engine Provider
# Supported options: 'watsonx' (default), 'openai', 'gemini'
# If cloud credentials are not supplied, the app automatically runs on
# the deterministic rural advisory engine without crashing.
AI_PROVIDER=watsonx

# IBM watsonx.ai (Granite Models)
WATSONX_API_KEY=
WATSONX_PROJECT_ID=
WATSONX_URL=https://us-south.ml.cloud.ibm.com
WATSONX_MODEL_ID=ibm/granite-3-8b-instruct

# OpenAI (Swappable Provider)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Google Gemini (Swappable Provider)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Supabase (PostGIS & Persistent Geocode Cache - Optional)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
